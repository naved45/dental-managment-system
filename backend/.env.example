MONGO_URI=mongodb://127.0.0.1:27017/dental_management
JWT_SECRET=change_this_secret_key
PORT=5000

# --- Email (optional but needed for Steps 8-10: confirmations, receipts, reminders) ---
# Leave these blank to run without email — the app works fine, it just skips sending.
# Example using Gmail: create an "App Password" in your Google Account security settings
# (not your normal password), then:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=your16digitapppassword
# Or use a free testing service like Mailtrap.io for development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="DentalCare Clinic" <no-reply@dentalcare.example>
